# ─── Auctra backend configuration (copy to backend/.env) ─────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS + Socket.IO)
CORS_ORIGINS=http://localhost:5173

# MySQL 8 — matches docker-compose.yml (host port 3307)
DATABASE_URL=mysql://auctra:auctra_dev_password@127.0.0.1:3307/auctra
# Used only by the integration/concurrency test suites (wiped on every run)
TEST_DATABASE_URL=mysql://auctra:auctra_dev_password@127.0.0.1:3307/auctra_test
# Size of Prisma's connection pool. Concurrent bids each hold one connection while waiting for the row lock.
DB_POOL_SIZE=20

# Redis 7 — matches docker-compose.yml (host port 6380)
REDIS_URL=redis://127.0.0.1:6380
TEST_REDIS_URL=redis://127.0.0.1:6380/15

# JWT secrets — generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Rate limits (per window)
# Development value. Use something like 10–30 per 15 minutes in production.
RATE_LIMIT_AUTH_MAX=200
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_BID_MAX=60
RATE_LIMIT_BID_WINDOW_SECONDS=10

# Auction lifecycle worker
LIFECYCLE_POLL_MS=1000
OUTBOX_POLL_MS=250
ENDING_SOON_SECONDS=300
# Anti-sniping: if > 0, a bid placed within this many seconds of the end extends the end time.
ANTI_SNIPE_WINDOW_SECONDS=0
ANTI_SNIPE_EXTENSION_SECONDS=60

# Development-only helpers (/api/v1/dev/*). Never enable in production.
ENABLE_DEV_ROUTES=true
LOG_LEVEL=info
