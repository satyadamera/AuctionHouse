{
  "name": "@auctra/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts database",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:deploy": "tsx scripts/db.ts migrate",
    "db:seed": "tsx database/seed/seed.ts",
    "db:reset": "tsx scripts/db.ts reset && tsx database/seed/seed.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration",
    "test:concurrency": "vitest run --config vitest.integration.config.ts tests/concurrency",
    "demo:race": "tsx ../scripts/concurrency-test/race-demo.ts",
    "demo:cache": "tsx ../scripts/demo/cache-demo.ts",
    "demo:lifecycle": "tsx ../scripts/demo/lifecycle-demo.ts",
    "bench": "tsx ../scripts/performance-test/bench.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.17",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/autocannon": "^7.12.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
